# Vars específiques de bias_analyzer. Copia aquest fitxer a
# bias_analyzer/.env (junt amb el .env de l'arrel, amb OPENAI_BASE/
# OPENAI_APIKEY/MODEL): app.py carrega tots dos, aquest no cal que
# toqui l'arrel ni dupliqui les vars compartides.

# Opcional: LLM objectiu a auditar, si vols que sigui diferent del MODEL
# que fa d'auditor (generador+analista). Si no es defineixen, bias_analyzer
# fa servir OPENAI_BASE/OPENAI_APIKEY/MODEL per tot.
# MODEL_OBJECTIU=openai/altre-model
# OPENAI_BASE_OBJECTIU=https://altre-proveidor.example.cat/v1
# OPENAI_APIKEY_OBJECTIU=altraAPIKey

# Opcional: idioma en que es formulen les preguntes a l'objectiu (per
# defecte català). Útil si el model objectiu no domina bé el català
# (ex: talkie-1930).
# IDIOMA_OBJECTIU=castellà

# Opcional: idioma de l'informe final (justificacions de l'analista).
# Independent de IDIOMA_OBJECTIU: es pot preguntar en un idioma i llegir
# l'informe en un altre. Per defecte català.
# IDIOMA_INFORME=català
