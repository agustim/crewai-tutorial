OPENAI_BASE=https://mylitellm.example.cat/v1
OPENAI_APIKEY=myAPIKey
MODEL=openai/qwen3.6-35b-no-thinking
EMBED_MODEL=all-MiniLM-L6-v2

# Opcional, només bias_analyzer: LLM objectiu a auditar, si vols que sigui
# diferent del MODEL que fa d'auditor (generador+analista). Si no es
# defineixen, bias_analyzer fa servir OPENAI_BASE/OPENAI_APIKEY/MODEL per tot.
# MODEL_OBJECTIU=openai/altre-model
# OPENAI_BASE_OBJECTIU=https://altre-proveidor.example.cat/v1
# OPENAI_APIKEY_OBJECTIU=altraAPIKey